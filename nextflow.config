process {
    executor = 'local'
    cpus = 2
    memory = '512 MB'
    time = '20 min'
    maxForks = 2
    errorStrategy = 'terminate'
    withName: ASSEMBLE_AND_SCREEN { memory = '2 GB' }
    withName: MAXIMUM_LIKELIHOOD_TREE { memory = '1 GB' }
}
executor.queueSize = 2
workDir = 'nextflow-work'
trace { enabled=true; file='results/wgs/nextflow_trace.tsv'; overwrite=true }
report { enabled=true; file='results/wgs/nextflow_execution.html'; overwrite=true }
timeline { enabled=true; file='results/wgs/nextflow_timeline.html'; overwrite=true }
manifest { name='Hospital-AMR-Genomic-Surveillance'; author='Vusumuzi Mabasa'; version='1.0.0'; nextflowVersion='>=24.10.5' }
