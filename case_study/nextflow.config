process {
 executor='local'
 cpus=2
 memory='1 GB'
 time='40 min'
 maxForks=2
 errorStrategy='terminate'
}
executor.queueSize=2
workDir='case_study/work'
trace { enabled=true; file='case_study/results/nextflow_trace.tsv'; overwrite=true }
report { enabled=true; file='case_study/results/nextflow_execution.html'; overwrite=true }
manifest { name='Public-Klebsiella-NIH-case-study'; version='1.0.0'; nextflowVersion='>=25.10.2' }
